rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function self(uid) { return verified() && request.auth.uid == uid; }
    function sp(id) { return get(/databases/$(database)/documents/spaces/$(id)).data; }
    function afterSpace(id) { return getAfter(/databases/$(database)/documents/spaces/$(id)).data; }
    function member(id) { return verified() && request.auth.uid in sp(id).memberUids; }
    function owner(id) { return member(id) && sp(id).ownerUid == request.auth.uid; }
    function isTierPlus(d) {
      return d.tier == 'plus' && (
        d.get('founderGrant', false) == true ||
        d.get('entitlementSource', '') == 'founder' ||
        (d.get('subscriptionExpiresAt', null) != null && d.subscriptionExpiresAt > request.time)
      );
    }
    function plus() { return isTierPlus(get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data); }
    function shortText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function validPin(pin) {
      return pin is map
        && pin.keys().hasOnly(['lat','lng','label','note','source'])
        && pin.lat is number && pin.lat >= -90 && pin.lat <= 90
        && pin.lng is number && pin.lng >= -180 && pin.lng <= 180
        && shortText(pin.label, 80) && pin.note is string && pin.note.size() <= 180
        && pin.source == 'manual';
    }
    function accountShape(d) {
      return d.spaceIds is list && d.ownedSpaceIds is list
        && d.spaceIds.toSet().size() == d.spaceIds.size()
        && d.ownedSpaceIds.toSet().size() == d.ownedSpaceIds.size()
        && d.spaceIds.hasAll(d.ownedSpaceIds);
    }
    function accountCapacity(old, d) {
      let maxSpaces = isTierPlus(d) ? 50 : 3;
      let maxOwned = isTierPlus(d) ? 20 : 3;
      let oldSpaces = old.get('spaceIds', []).size();
      let oldOwned = old.get('ownedSpaceIds', []).size();
      return (d.spaceIds.size() <= oldSpaces || d.spaceIds.size() <= maxSpaces)
        && (d.ownedSpaceIds.size() <= oldOwned || d.ownedSpaceIds.size() <= maxOwned);
    }
    function accountChange(uid, old, d) {
      let id = d.changedSpaceId;
      let joined = uid in afterSpace(id).memberUids;
      let owns = afterSpace(id).ownerUid == uid;
      let oldSpaces = old.get('spaceIds', []).toSet();
      let oldOwned = old.get('ownedSpaceIds', []).toSet();
      return d.spaceIds.toSet().difference(oldSpaces).hasOnly([id])
        && oldSpaces.difference(d.spaceIds.toSet()).hasOnly([id])
        && d.ownedSpaceIds.toSet().difference(oldOwned).hasOnly([id])
        && oldOwned.difference(d.ownedSpaceIds.toSet()).hasOnly([id])
        && (id in d.spaceIds) == joined && (id in d.ownedSpaceIds) == owns;
    }
    match /accounts/{uid} {
      allow read: if self(uid);
      allow create: if self(uid) && request.resource.data.keys().hasOnly(['tier','spaceIds','ownedSpaceIds','changedSpaceId'])
        && request.resource.data.tier == 'basic' && accountShape(request.resource.data)
        && accountCapacity({'spaceIds': [], 'ownedSpaceIds': []}, request.resource.data)
        && accountChange(uid, {'spaceIds': [], 'ownedSpaceIds': []}, request.resource.data);
      allow update: if verified() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spaceIds','ownedSpaceIds','changedSpaceId'])
        && accountShape(request.resource.data)
        && accountCapacity(resource.data, request.resource.data)
        && accountChange(uid, resource.data, request.resource.data)
        && (self(uid) || (owner(request.resource.data.changedSpaceId) && !(uid in afterSpace(request.resource.data.changedSpaceId).memberUids))
          || (sp(request.resource.data.changedSpaceId).ownerUid == uid && afterSpace(request.resource.data.changedSpaceId).ownerUid == request.auth.uid));
      match /spaceRefs/{id} {
        allow read: if self(uid);
        allow create: if self(uid) && uid in afterSpace(id).memberUids
          && request.resource.data.keys().hasOnly(['spaceId','name','kind','joinedAt'])
          && request.resource.data.spaceId == id && request.resource.data.name == afterSpace(id).name
          && request.resource.data.kind == afterSpace(id).kind && request.resource.data.joinedAt == request.time;
        allow delete: if verified() && !(uid in afterSpace(id).memberUids) && (self(uid) || owner(id));
      }
      match /tutorial/{state} {
        allow read, delete: if self(uid) && state == 'state';
        allow create, update: if self(uid) && state == 'state'
          && request.resource.data.keys().hasOnly(['status','updatedAt'])
          && request.resource.data.status in ['notStarted','inProgress','awaitingSpace','skipped','completed']
          && request.resource.data.updatedAt == request.time;
      }
      match /locationState/{state} {
        allow read: if self(uid) && state == 'current';
        allow write: if false;
      }
      match /notificationPrefs/{scope} {
        allow read: if self(uid);
        allow create, update: if self(uid)
          && request.resource.data.keys().hasOnly(['enabled','quietStart','quietEnd','timeZone','updatedAt','photos','reactions','moods'])
          && (!('photos' in request.resource.data) || request.resource.data.photos is bool)
          && (!('reactions' in request.resource.data) || request.resource.data.reactions is bool)
          && (!('moods' in request.resource.data) || request.resource.data.moods is bool)
          && request.resource.data.enabled is bool
          && request.resource.data.quietStart is int
          && request.resource.data.quietStart >= 0 && request.resource.data.quietStart < 1440
          && request.resource.data.quietEnd is int
          && request.resource.data.quietEnd >= 0 && request.resource.data.quietEnd < 1440
          && request.resource.data.timeZone is string
          && request.resource.data.timeZone.size() <= 64
          && request.resource.data.updatedAt == request.time
          && (scope == 'global' || scope in get(/databases/$(database)/documents/accounts/$(uid)).data.spaceIds);
      }
      match /pushDevices/{deviceId} {
        allow read, delete: if self(uid);
        allow create, update: if self(uid)
          && deviceId.matches('[A-Za-z0-9_-]{20,1000}')
          && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() <= 1000
          && request.resource.data.platform in ['android','ios']
          && request.resource.data.updatedAt == request.time;
      }
      match /activity/{item} {
        allow read: if self(uid);
        allow update: if self(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
      }
      match /blocks/{blockedUid} {
        allow read, delete: if self(uid);
        allow create: if self(uid) && blockedUid != uid
          && request.resource.data.keys().hasOnly(['blockedUid','createdAt'])
          && request.resource.data.blockedUid == blockedUid
          && request.resource.data.createdAt == request.time;
      }
      match /hidden/{item} {
        allow read, delete: if self(uid);
        allow create: if self(uid)
          && request.resource.data.keys().hasOnly(['spaceId','kind','contentId','createdAt'])
          && request.resource.data.spaceId is string
          && request.resource.data.kind in ['moment','task','plan']
          && shortText(request.resource.data.contentId, 160)
          && request.resource.data.createdAt == request.time;
      }
    }
    match /safetyReports/{report} {
      allow create: if verified() && member(request.resource.data.spaceId)
        && request.resource.data.keys().hasOnly(['reporterUid','spaceId','kind','contentId','targetUid','reason','createdAt','status'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.kind in ['member','moment','task','plan']
        && shortText(request.resource.data.contentId, 160)
        && request.resource.data.targetUid is string
        && request.resource.data.reason in ['harassment','unsafe','spam','other']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read: if verified() && request.auth.token.email == 'gadielmanalo19@gmail.com';
      allow update: if verified() && request.auth.token.email == 'gadielmanalo19@gmail.com'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','resolution'])
        && request.resource.data.status in ['reviewing','closed']
        && (request.resource.data.status == 'reviewing'
          || request.resource.data.resolution in ['no_action','handled_externally'])
        && request.resource.data.reviewedAt == request.time;
    }
    match /deletionRequests/{uid} {
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['uid','email','createdAt','status'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending';
      allow read: if self(uid) || (verified() && request.auth.token.email == 'gadielmanalo19@gmail.com');
      // Only the trusted operator script can move processing/complete states.
      allow update: if false;
    }
    function inviteValid(token, id) {
      let d = get(/databases/$(database)/documents/invites/$(token)).data;
      return d.spaceId == id && d.revoked == false && d.redeemedUid == null && d.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/invites/$(token)).data.redeemedUid == request.auth.uid
        && (!sp(id).get('requireApproval', false)
          || (exists(/databases/$(database)/documents/spaces/$(id)/pendingJoins/$(request.auth.uid))
            && get(/databases/$(database)/documents/spaces/$(id)/pendingJoins/$(request.auth.uid)).data.status == 'approved'
            && get(/databases/$(database)/documents/spaces/$(id)/pendingJoins/$(request.auth.uid)).data.token == token));
    }
    match /spaceDeletionJobs/{id} {
      allow read: if self(resource.data.requestedBy);
      allow create: if owner(id)
        && request.resource.data.keys().hasOnly(['requestedBy','spaceName','memberUids','status','requestedAt'])
        && request.resource.data.keys().hasAll(['requestedBy','spaceName','memberUids','status','requestedAt'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.spaceName == sp(id).name
        && request.resource.data.memberUids == sp(id).memberUids
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && afterSpace(id).get('deletionStatus', '') == 'pending'
        && afterSpace(id).memberUids == [];
    }
    match /spaces/{id} {
      allow read: if member(id);
      allow create: if verified() && request.resource.data.keys().hasOnly(['name','kind','timeZone','ownerUid','memberUids','memberCount','activeTaskCount','createdAt'])
        && shortText(request.resource.data.name, 80) && request.resource.data.kind in ['family','housemates','friends','crew','custom','couple','organization']
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberCount == 1 && request.resource.data.activeTaskCount == 0 && request.resource.data.createdAt == request.time
        && id in getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('ownedSpaceIds', []);
      function joining() {
        let d = request.resource.data;
        return verified() && !(request.auth.uid in resource.data.memberUids)
          && d.diff(resource.data).affectedKeys().hasOnly(['memberUids','memberCount','joinToken'])
          && d.memberUids.toSet() == resource.data.memberUids.toSet().union([request.auth.uid].toSet())
          && d.memberCount == d.memberUids.size() && d.memberCount <= 20
          && getAfter(/databases/$(database)/documents/spaces/$(id)/members/$(request.auth.uid)).data.status == 'active'
          && inviteValid(d.joinToken, id)
          && id in getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.spaceIds;
      }
      function removing() {
        let d = request.resource.data;
        return member(id) && (owner(id) || d.removedUid == request.auth.uid) && d.removedUid != resource.data.ownerUid
          && d.removedUid in resource.data.memberUids
          && d.diff(resource.data).affectedKeys().hasOnly(['memberUids','memberCount','removedUid'])
          && d.memberUids.toSet() == resource.data.memberUids.toSet().difference([d.removedUid].toSet())
          && d.memberCount == d.memberUids.size()
          && getAfter(/databases/$(database)/documents/spaces/$(id)/members/$(d.removedUid)).data.status == 'removed'
          && !(id in getAfter(/databases/$(database)/documents/accounts/$(d.removedUid)).data.spaceIds);
      }
      function taskCount() {
        let d = request.resource.data;
        let path = /databases/$(database)/documents/spaces/$(id)/tasks/$(d.changedTaskId);
        return member(id) && d.diff(resource.data).affectedKeys().hasOnly(['activeTaskCount','changedTaskId'])
          && d.activeTaskCount >= 0 && d.activeTaskCount <= 300
          && ((!exists(path) && getAfter(path).data.creatorUid == request.auth.uid && d.activeTaskCount == resource.data.activeTaskCount + 1)
          || (get(path).data.status != 'completed' && (!existsAfter(path) || getAfter(path).data.status == 'completed') && d.activeTaskCount == resource.data.activeTaskCount - 1));
      }
      function routineCount() {
        let d = request.resource.data;
        let path = /databases/$(database)/documents/spaces/$(id)/routines/$(d.changedRoutineId);
        return member(id) && d.diff(resource.data).affectedKeys().hasOnly(['routineCount','changedRoutineId'])
          && d.routineCount is int && d.routineCount >= 0
          && (d.routineCount <= 5 || (exists(path) && d.routineCount < resource.data.get('routineCount', 0)))
          && ((!exists(path) && existsAfter(path) && d.routineCount == resource.data.get('routineCount', 0) + 1)
            || (exists(path) && !existsAfter(path) && d.routineCount ==
              (resource.data.get('routineCount', 0) > 0 ? resource.data.routineCount - 1 : 0)));
      }
      function requestDeletion() {
        let d = request.resource.data;
        return owner(id) && !('deletionStatus' in resource.data)
          && d.diff(resource.data).affectedKeys().hasOnly([
            'memberUids','memberCount','ownerUid','deletionStatus','deletionRequestedAt'])
          && d.memberUids == [] && d.memberCount == 0 && d.ownerUid == null
          && d.deletionStatus == 'pending'
          && d.deletionRequestedAt == request.time
          && getAfter(/databases/$(database)/documents/spaceDeletionJobs/$(id)).data.requestedBy == request.auth.uid;
      }
      allow update: if joining() || removing() || taskCount() || routineCount()
        || requestDeletion()
        || (owner(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeInviteToken']))
        || (owner(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requireApproval']))
        || (owner(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingOwnerUid']) && (request.resource.data.pendingOwnerUid == null || request.resource.data.pendingOwnerUid in resource.data.memberUids))
        || (member(id) && resource.data.get('pendingOwnerUid', null) == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid','pendingOwnerUid'])
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.pendingOwnerUid == null
          && id in getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.ownedSpaceIds
          && !(id in getAfter(/databases/$(database)/documents/accounts/$(resource.data.ownerUid)).data.ownedSpaceIds));
      // Space deletion is completed only by the trusted cleanup worker.
      allow delete: if false;
      match /members/{uid} {
        allow read: if member(id);
        allow create, update: if (self(uid) && (!exists(/databases/$(database)/documents/spaces/$(id)/members/$(uid)) || resource.data.status == 'removed')
          && uid in afterSpace(id).memberUids && request.resource.data.uid == uid
          && request.resource.data.status == 'active' && shortText(request.resource.data.name, 60)
          && request.resource.data.joinedAt == request.time
          && request.resource.data.keys().hasOnly(['uid','name','role','familyRole','status','joinedAt','joinToken'])
          && ((afterSpace(id).ownerUid == uid && request.resource.data.role == 'owner')
            || (request.resource.data.role == 'member' && inviteValid(request.resource.data.joinToken, id))))
          ;
        allow update: if verified() && resource.data.status == 'active'
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'removed'
            && !(uid in afterSpace(id).memberUids) && (self(uid) || owner(id)))
          || (self(uid) && member(id)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && shortText(request.resource.data.name, 60))
          || (member(id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role == (afterSpace(id).ownerUid == uid ? 'owner' : 'member')
            && afterSpace(id).ownerUid != sp(id).ownerUid)
          || (member(id) && resource.data.get('isDependent', false) == true));
        allow delete: if member(id) && (resource.data.get('isDependent', false) == true || owner(id));
      }
      match /pendingJoins/{joinUid} {
        allow read: if member(id) || self(joinUid);
        allow create: if verified() && self(joinUid) && sp(id).get('requireApproval', false)
          && request.resource.data.keys().hasOnly(['uid','name','email','token','status','requestedAt'])
          && request.resource.data.uid == joinUid && request.resource.data.status == 'pending'
          && request.resource.data.requestedAt == request.time
          && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.spaceId == id
          && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.revoked == false
          && get(/databases/$(database)/documents/invites/$(request.resource.data.token)).data.expiresAt > request.time;
        allow update: if owner(id) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['approved','declined'];
        allow delete: if member(id) || self(joinUid);
      }
      // Immutable, transaction-bound facts. Clients cannot write account inboxes.
      match /events/{eventId} {
        allow read: if member(id);
        function taskPath() {
          return /databases/$(database)/documents/spaces/$(id)/tasks/$(request.resource.data.entityId);
        }
        function taskEvent() {
          let e = request.resource.data;
          let after = getAfter(taskPath()).data;
          return member(id) && existsAfter(taskPath())
            && after.updatedAt == request.time
              && ((e.type == 'taskAssigned' && !exists(taskPath())
                    && after.creatorUid == request.auth.uid && after.requestedUid == e.targetUid)
                || (e.type == 'taskAssigned' && exists(taskPath())
                    && get(taskPath()).data.requestedUid != e.targetUid
                    && after.requestedUid == e.targetUid)
              || (exists(taskPath()) &&
                ((e.type == 'helpRequested'
                    && get(taskPath()).data.get('helpNeeded', false) == false
                    && after.get('helpNeeded', false) == true)
                  || (e.type == 'helpRequested' && get(taskPath()).data.status == 'accepted'
                    && after.status == 'needsHelp' && after.ownerUid == request.auth.uid)
                  || (e.type == 'covered' && after.status == 'accepted'
                    && after.ownerUid != get(taskPath()).data.ownerUid
                    && (after.ownerUid == request.auth.uid || get(taskPath()).data.ownerUid == request.auth.uid)
                    && e.targetUid == after.creatorUid)
                  || (e.type == 'completed' && get(taskPath()).data.status != 'completed'
                    && after.status == 'completed' && after.ownerUid == request.auth.uid))));
        }
        function spaceEvent() {
          let e = request.resource.data;
          return (e.type == 'joined' && e.entityId == request.auth.uid
                    && e.targetUid == request.auth.uid
                    && !(request.auth.uid in sp(id).memberUids)
                    && request.auth.uid in afterSpace(id).memberUids)
            || (e.type in ['left','removed'] && e.targetUid == e.entityId
                    && e.entityId in sp(id).memberUids
                    && !(e.entityId in afterSpace(id).memberUids)
                    && (e.type == 'left' ? e.entityId == request.auth.uid : owner(id)))
            || (owner(id) && e.type == 'ownershipOffered'
                    && e.targetUid == e.entityId && e.targetUid in sp(id).memberUids
                    && sp(id).get('pendingOwnerUid', null) != e.targetUid
                    && afterSpace(id).pendingOwnerUid == e.targetUid)
            || (member(id) && e.type == 'ownershipAccepted'
                    && e.entityId == request.auth.uid && e.targetUid == request.auth.uid
                    && sp(id).ownerUid != request.auth.uid
                    && afterSpace(id).ownerUid == request.auth.uid)
            || (owner(id) && e.type == 'ownershipCancelled'
                    && e.targetUid == e.entityId
                    && sp(id).get('pendingOwnerUid', null) == e.targetUid
                    && e.targetUid != null && afterSpace(id).pendingOwnerUid == null);
        }
        function extraTaskEvent() {
          let e = request.resource.data;
          return member(id) && exists(taskPath()) &&
            ((e.type == 'taskCancelled' && !existsAfter(taskPath()))
            || (e.type == 'taskArrival'
              && getAfter(/databases/$(database)/documents/spaces/$(id)/tasks/$(e.entityId)/arrivals/$(request.auth.uid)).data.checkedInAt == request.time)
            || (existsAfter(taskPath()) && getAfter(taskPath()).data.updatedAt == request.time &&
              ((e.type == 'helpOffered' && get(taskPath()).data.offeredUid == null
                && getAfter(taskPath()).data.offeredUid == request.auth.uid
                && e.targetUid == get(taskPath()).data.ownerUid)
              || (e.type == 'taskDeclined' && get(taskPath()).data.requestedUid == request.auth.uid
                && getAfter(taskPath()).data.status == 'unclaimed'
                && getAfter(taskPath()).data.requestedUid == null)
              || (e.type == 'taskEdited' && getAfter(taskPath()).data.diff(get(taskPath()).data).affectedKeys().hasAny(['title','note','destination','pin'])))));
        }
        function taskAudience() {
          let before = get(taskPath()).data;
          let after = existsAfter(taskPath()) ? getAfter(taskPath()).data : before;
          let audience = request.resource.data.affectedUids;
          return audience is list && audience.size() <= 5
            && audience.hasAll([before.creatorUid])
            && audience.hasOnly([before.creatorUid, before.get('ownerUid', null), before.get('requestedUid', null), before.get('offeredUid', null), after.get('ownerUid', null), after.get('offeredUid', null)]);
        }
        function planPath() {
          return /databases/$(database)/documents/spaces/$(id)/plans/$(request.resource.data.entityId);
        }
        function planEvent() {
          let e = request.resource.data;
          return member(id) &&
            ((e.type == 'planCancelled' && exists(planPath()) && !existsAfter(planPath())
              && get(planPath()).data.ownerUid == request.auth.uid)
            || (e.type == 'planArrival' && exists(planPath())
              && getAfter(/databases/$(database)/documents/spaces/$(id)/plans/$(e.entityId)/arrivals/$(request.auth.uid)).data.checkedInAt == request.time)
            || (e.type in ['planAdded','planChanged'] && existsAfter(planPath())
              && getAfter(planPath()).data.ownerUid == request.auth.uid
              && getAfter(planPath()).data.updatedAt == request.time
              && (e.type == 'planAdded' ? !exists(planPath())
                : exists(planPath()) && getAfter(planPath()).data.revision == get(planPath()).data.revision + 1)));
        }
        function planAudience() {
          let after = existsAfter(planPath()) ? getAfter(planPath()).data : get(planPath()).data;
          let before = exists(planPath()) ? get(planPath()).data : after;
          let audience = request.resource.data.affectedUids;
          return audience is list && audience.size() <= 41
            && audience.hasAll([before.ownerUid])
            && audience.toSet().difference(before.participants.toSet().union(after.participants.toSet()).union([before.ownerUid, after.ownerUid].toSet())).size() == 0;
        }
        allow create: if verified()
          && request.resource.data.keys().hasOnly(['type','actorUid','entityId','targetUid','recipientUids','affectedUids','taskVersion','planRevision','createdAt'])
          && request.resource.data.keys().hasAll(['type','actorUid','entityId','recipientUids','createdAt'])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && shortText(request.resource.data.entityId, 160)
          && request.resource.data.recipientUids == afterSpace(id).memberUids
          && (request.resource.data.type in ['taskAssigned','helpOffered']
            ? request.resource.data.taskVersion == getAfter(taskPath()).data.version
            : !('taskVersion' in request.resource.data))
          && (request.resource.data.type in ['planAdded','planChanged']
            ? request.resource.data.planRevision == getAfter(planPath()).data.revision
            : !('planRevision' in request.resource.data))
          && (request.resource.data.type in ['covered','completed','helpOffered','taskDeclined','taskEdited','taskCancelled','taskArrival']
            ? ('affectedUids' in request.resource.data && taskAudience())
            : request.resource.data.type in ['planAdded','planChanged','planCancelled','planArrival']
              ? ('affectedUids' in request.resource.data && planAudience())
              : !('affectedUids' in request.resource.data))
          && (request.resource.data.type in ['taskAssigned','helpRequested','covered','completed']
            ? taskEvent()
            : request.resource.data.type in ['taskCancelled','taskArrival','helpOffered','taskDeclined','taskEdited']
              ? extraTaskEvent()
              : request.resource.data.type in ['planAdded','planChanged','planCancelled','planArrival']
                ? planEvent() : spaceEvent());
      }
      match /tasks/{task} {
        // Basic completed-task reads use task-access, which can enforce the
        // space's IANA calendar boundary. Firestore rules cannot resolve it.
        allow get: if member(id) && (!exists(/databases/$(database)/documents/spaces/$(id)/tasks/$(task)) || resource.data.status != 'completed' || plus());
        allow list: if member(id) && (resource.data.status != 'completed' || plus());
        allow delete: if member(id) && (resource.data.status == 'completed'
          || (afterSpace(id).activeTaskCount == sp(id).activeTaskCount - 1 && afterSpace(id).changedTaskId == task));
        allow create: if member(id) && request.resource.data.keys().hasOnly(['title','note','destination','pin','creatorUid','requestedUid','ownerUid','offeredUid','status','scheduledLocalDate','version','completedAt','createdAt','updatedAt','subtasks','helpNeeded','handoffToUid','activity'])
          && (!('pin' in request.resource.data) || validPin(request.resource.data.pin))
          && shortText(request.resource.data.title, 120) && request.resource.data.creatorUid == request.auth.uid
          && request.resource.data.scheduledLocalDate is string
          && request.resource.data.scheduledLocalDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.ownerUid == null && request.resource.data.offeredUid == null && request.resource.data.completedAt == null
          && request.resource.data.version == 1 && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && ((request.resource.data.requestedUid == null && request.resource.data.status == 'unclaimed')
            || (request.resource.data.requestedUid in sp(id).memberUids && request.resource.data.status == 'requested'
              && !exists(/databases/$(database)/documents/accounts/$(request.resource.data.requestedUid)/blocks/$(request.auth.uid))))
          && afterSpace(id).activeTaskCount == sp(id).activeTaskCount + 1 && afterSpace(id).changedTaskId == task;
        function transition() {
          let a = resource.data;
          let b = request.resource.data;
          let me = request.auth.uid;
          return (a.status == 'unclaimed' || (a.status == 'requested' && (a.requestedUid == me || !(a.requestedUid in sp(id).memberUids))) || (a.status in ['accepted','needsHelp'] && !(a.ownerUid in sp(id).memberUids))) && b.status == 'accepted' && b.ownerUid == me && b.requestedUid == null && b.offeredUid == null && b.completedAt == a.completedAt
            || a.status == 'requested' && a.requestedUid == me && b.status == 'unclaimed' && b.ownerUid == a.ownerUid && b.requestedUid == null && b.offeredUid == a.offeredUid && b.completedAt == a.completedAt
            || a.status == 'accepted' && a.ownerUid == me && b.status == 'needsHelp' && b.ownerUid == me && b.requestedUid == a.requestedUid && b.offeredUid == a.offeredUid && b.completedAt == a.completedAt
            || a.status == 'needsHelp' && a.ownerUid != me && a.offeredUid == null && b.offeredUid == me && b.status == a.status && b.ownerUid == a.ownerUid && b.requestedUid == a.requestedUid && b.completedAt == a.completedAt
            || a.status == 'needsHelp' && a.ownerUid == me && a.offeredUid in sp(id).memberUids && b.status == 'accepted' && b.ownerUid == a.offeredUid && b.offeredUid == null && b.requestedUid == a.requestedUid && b.completedAt == a.completedAt
            || a.status in ['accepted','needsHelp'] && a.ownerUid == me && b.status == 'completed' && b.ownerUid == me && b.requestedUid == a.requestedUid && b.offeredUid == null && b.completedAt == request.time
              && afterSpace(id).activeTaskCount == sp(id).activeTaskCount - 1 && afterSpace(id).changedTaskId == task;
        }
        function released() {
          let removed = afterSpace(id).get('removedUid', '');
          let a = resource.data;
          let b = request.resource.data;
          return a.status != 'completed' && removed in sp(id).memberUids && !(removed in afterSpace(id).memberUids)
            && (owner(id) || request.auth.uid == removed) && b.completedAt == a.completedAt
            && (((a.ownerUid == removed || a.requestedUid == removed) && b.status == 'unclaimed' && b.ownerUid == null && b.requestedUid == null && b.offeredUid == null)
              || (a.offeredUid == removed && b.offeredUid == null && b.status == a.status && b.ownerUid == a.ownerUid && b.requestedUid == a.requestedUid));
        }
        function contentEdit() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','note','destination','pin','requestedUid','subtasks','helpNeeded','handoffToUid','activity','updatedAt','version'])
            && (!('pin' in request.resource.data) || validPin(request.resource.data.pin))
            && request.resource.data.requestedUid == resource.data.requestedUid
            && request.resource.data.updatedAt == request.time
            && shortText(request.resource.data.title, 120);
        }
        function helpTakeover() {
          return resource.data.get('helpNeeded', false) == true
            && resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid','requestedUid','helpNeeded','activity','updatedAt'])
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.requestedUid == null
            && request.resource.data.helpNeeded == false
            && request.resource.data.updatedAt == request.time;
        }
        function reassign() {
          return resource.data.creatorUid == request.auth.uid
            && resource.data.status in ['unclaimed','requested']
            && request.resource.data.status == 'requested'
            && request.resource.data.ownerUid == null
            && request.resource.data.offeredUid == null
            && request.resource.data.requestedUid in sp(id).memberUids
            && request.resource.data.requestedUid != resource.data.requestedUid
            && !exists(/databases/$(database)/documents/accounts/$(request.resource.data.requestedUid)/blocks/$(request.auth.uid))
            && request.resource.data.version == resource.data.version + 1
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','requestedUid','version','updatedAt','title','note','destination'])
            && shortText(request.resource.data.title, 120);
        }
        function unassign() {
          return resource.data.creatorUid == request.auth.uid
            && resource.data.status == 'requested'
            && request.resource.data.status == 'unclaimed'
            && request.resource.data.ownerUid == null
            && request.resource.data.requestedUid == null
            && request.resource.data.version == resource.data.version + 1
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','requestedUid','version','updatedAt','title','note','destination'])
            && shortText(request.resource.data.title, 120);
        }
        allow update: if member(id) && resource.data.status != 'completed' && (request.resource.data.version == resource.data.version
          ? (contentEdit() || helpTakeover())
          : (request.resource.data.version == resource.data.version + 1
            && request.resource.data.updatedAt == request.time
            && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','ownerUid','requestedUid','offeredUid','completedAt','completedLocalDate','version','updatedAt','subtasks','helpNeeded','handoffToUid','activity'])
              && (transition() || released())) || reassign() || unassign() || contentEdit())));
        match /operations/{op} {
          allow read: if member(id) && op.matches(request.auth.uid + '_.*');
          allow create: if member(id) && request.resource.data.keys().hasOnly(['actorUid','version','action','appliedAt'])
            && request.resource.data.actorUid == request.auth.uid && request.resource.data.appliedAt == request.time
            && request.resource.data.version == getAfter(/databases/$(database)/documents/spaces/$(id)/tasks/$(task)).data.version
            && request.resource.data.version == get(/databases/$(database)/documents/spaces/$(id)/tasks/$(task)).data.version + 1;
        }
        match /arrivals/{arrivalUid} {
          allow read: if member(id);
          allow create, update: if member(id) && self(arrivalUid)
            && request.resource.data.keys().hasOnly(['uid','checkedInAt'])
            && request.resource.data.uid == arrivalUid
            && request.resource.data.checkedInAt == request.time;
          allow delete: if member(id) && self(arrivalUid);
        }
      }
      match /routines/{routine} {
        allow read: if member(id);
        allow create: if member(id)
          && request.resource.data.keys().hasOnly(['id','title','cadence','assignedUid','creatorUid','createdAt'])
          && request.resource.data.id == routine
          && shortText(request.resource.data.title, 120)
          && request.resource.data.cadence in ['daily','weekdays','weekly']
          && (request.resource.data.assignedUid == null || request.resource.data.assignedUid in sp(id).memberUids)
          && request.resource.data.creatorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && afterSpace(id).get('routineCount', 0) <= 5
          && afterSpace(id).get('routineCount', 0) == sp(id).get('routineCount', 0) + 1
          && afterSpace(id).changedRoutineId == routine;
        allow delete: if member(id)
          && (resource.data.creatorUid == request.auth.uid || owner(id))
          && afterSpace(id).routineCount ==
            (sp(id).get('routineCount', 0) > 0 ? sp(id).routineCount - 1 : 0)
          && afterSpace(id).changedRoutineId == routine;
      }
      match /moments/{moment} {
        allow read, create, update, delete: if member(id);
        match /reactions/{reactionUid} {
          allow read: if member(id);
          // Trusted media gateway validates the canonical Supabase photo first.
          allow create, update, delete: if false;
        }
      }
      match /locationSessions/{sessionUid} {
        allow get: if member(id) && request.auth.uid in resource.data.recipientUids
          && resource.data.expiresAt > request.time;
        allow list: if false;
        allow create: if member(id) && self(sessionUid)
          && request.resource.data.keys().hasOnly(['uid','name','lat','lng','accuracy','recipientUids','durationMinutes','startedAt','updatedAt','expiresAt'])
          && request.resource.data.uid == sessionUid
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && request.resource.data.accuracy is number && request.resource.data.accuracy >= 0 && request.resource.data.accuracy <= 10000
          && request.resource.data.recipientUids == sp(id).memberUids
          && request.resource.data.durationMinutes in [15,30,60]
          && request.resource.data.startedAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(request.resource.data.durationMinutes, 'm');
        allow update: if member(id) && self(sessionUid)
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lat','lng','accuracy','updatedAt'])
          && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && request.resource.data.accuracy is number && request.resource.data.accuracy >= 0 && request.resource.data.accuracy <= 10000
          && request.resource.data.updatedAt == request.time;
        allow delete: if self(sessionUid);
      }
      match /checkIns/{uid} {
        allow read: if member(id);
        allow delete: if member(id) && self(uid);
        // Trusted mood function computes the space-local next midnight.
        allow create, update: if false;
      }
      // Minimal proof for publishing attached photos after Basic task history expires.
      // No collection listing and no editable completion metadata.
      match /taskCompletions/{taskId} {
        allow get: if member(id);
        allow create: if member(id)
          && get(/databases/$(database)/documents/spaces/$(id)/tasks/$(taskId)).data.status != 'completed'
          && getAfter(/databases/$(database)/documents/spaces/$(id)/tasks/$(taskId)).data.status == 'completed'
          && request.resource.data.keys().hasOnly(['title','ownerUid','completedAt'])
          && request.resource.data.title == getAfter(/databases/$(database)/documents/spaces/$(id)/tasks/$(taskId)).data.title
          && request.resource.data.ownerUid == getAfter(/databases/$(database)/documents/spaces/$(id)/tasks/$(taskId)).data.ownerUid
          && request.resource.data.completedAt == request.time;
      }
      match /plans/{plan} {
        allow read: if member(id);
        allow delete: if member(id) && resource.data.ownerUid == request.auth.uid;
        allow create, update: if member(id) && (!exists(/databases/$(database)/documents/spaces/$(id)/plans/$(plan)) || resource.data.ownerUid == request.auth.uid)
          && request.resource.data.keys().hasOnly(['ownerUid','title','note','allDay','startMillis','endMillis','participants','pin','source','sourceCalendarId','sourceEventId','sourceUpdatedAt','reminder','revision','lastMutationId','updatedAt'])
          && request.resource.data.revision == (resource == null ? 1 : resource.data.get('revision', 0) + 1)
          && (!('lastMutationId' in request.resource.data) || shortText(request.resource.data.lastMutationId, 100))
          && request.resource.data.get('reminder', 'none') in ['none','atStart','tenMinutes','oneHour','oneDay','morningOf','morningBefore']
          && (request.resource.data.allDay == true
            ? request.resource.data.get('reminder', 'none') in ['none','morningOf','morningBefore']
            : request.resource.data.get('reminder', 'none') in ['none','atStart','tenMinutes','oneHour','oneDay'])
          && (!('pin' in request.resource.data) || validPin(request.resource.data.pin))
          && (!('source' in request.resource.data)
              || (request.resource.data.source == 'google'
                && shortText(request.resource.data.sourceCalendarId, 300)
                && shortText(request.resource.data.sourceEventId, 300)
                && shortText(request.resource.data.sourceUpdatedAt, 80)))
          && request.resource.data.ownerUid == request.auth.uid && shortText(request.resource.data.title, 100)
          && request.resource.data.note is string && request.resource.data.note.size() <= 500 && request.resource.data.allDay is bool
          && request.resource.data.startMillis is int && request.resource.data.endMillis is int && request.resource.data.endMillis > request.resource.data.startMillis
          && request.resource.data.participants is list && request.resource.data.participants.size() <= 19
          && request.resource.data.participants.toSet().size() == request.resource.data.participants.size()
          && sp(id).memberUids.hasAll(request.resource.data.participants) && request.resource.data.updatedAt == request.time;
        match /arrivals/{arrivalUid} {
          allow read: if member(id);
          allow create, update: if member(id) && self(arrivalUid)
            && request.resource.data.keys().hasOnly(['uid','checkedInAt'])
            && request.resource.data.uid == arrivalUid
            && request.resource.data.checkedInAt == request.time;
          allow delete: if member(id) && self(arrivalUid);
        }
      }
    }
    match /profiles/{uid} {
      allow get: if verified() && (self(uid) ||
        get(/databases/$(database)/documents/accounts/$(uid)).data.get('spaceIds', []).hasAny(
          get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data.get('spaceIds', [])));
      allow list: if false;
      allow create, update: if verified() && self(uid)
        && request.resource.data.keys().hasOnly(['imageBase64','updatedAt'])
        && request.resource.data.imageBase64 is string
        && request.resource.data.imageBase64.size() <= 160000
        && request.resource.data.updatedAt == request.time;
      allow delete: if self(uid);
    }
    match /invites/{token} {
      allow get: if verified() && ((resource.data.expiresAt > request.time && resource.data.revoked == false) || owner(resource.data.spaceId));
      allow create: if verified() && token.matches('[A-Za-z0-9_-]{6,32}') && owner(request.resource.data.spaceId)
        && request.resource.data.keys().hasOnly(['spaceId','spaceName','kind','creatorUid','createdAt','expiresAt','redeemedUid','revoked','requireApproval'])
        && request.resource.data.requireApproval == sp(request.resource.data.spaceId).get('requireApproval', false)
        && request.resource.data.spaceName == sp(request.resource.data.spaceId).name && request.resource.data.kind == sp(request.resource.data.spaceId).kind
        && request.resource.data.creatorUid == request.auth.uid && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && request.resource.data.redeemedUid == null && request.resource.data.revoked == false;
      allow update: if verified() && ((owner(resource.data.spaceId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked']) && request.resource.data.revoked == true)
        || (owner(resource.data.spaceId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requireApproval'])
          && request.resource.data.requireApproval == afterSpace(resource.data.spaceId).get('requireApproval', false))
        || (resource.data.revoked == false && resource.data.expiresAt > request.time && resource.data.redeemedUid == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedUid']) && request.resource.data.redeemedUid == request.auth.uid
          && !(request.auth.uid in sp(resource.data.spaceId).memberUids) && request.auth.uid in afterSpace(resource.data.spaceId).memberUids));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
